    {"id": 15, "name": "open_text", "kind": "non_fill", "meaning": "Free-writing question, never auto-filled", "examples": ["Why do you want this role?", "Tell us about yourself", "Describe a project"], "source": "user writes it"},
    {"id": 16, "name": "unsupported", "kind": "non_fill", "meaning": "Anything not in the 15 profile fields, never auto-filled", "examples": ["Date of birth", "Gender", "Father's name", "Address", "Pincode", "Aadhaar", "PAN", "Stipend", "Notice period", "Availability", "Relocation", "Work mode", "Referral", "Resume link", "10th marks", "12th marks", "Languages known", "Nationality"], "source": "not in profile"}
  ],
  "decision_rules": [
    "Location or City -> city; State -> state; Address or Pincode -> unsupported.",
    "Year of passing / Batch / Graduation year -> graduation_year; Current year / Year of study / Which year are you in -> year_of_study.",
    "Percentage or Marks -> unsupported (only CGPA is supported).",
    "Course / Degree / Qualification -> degree; Branch / Stream / Department -> branch.",
    "Resume link / Upload resume / Portfolio -> unsupported.",
    "Questions about willingness, availability, preferences, or personal details not in the schema -> unsupported.",
    "Any free-writing question -> open_text."
  ],
  "question_types": ["short_text", "paragraph", "multiple_choice", "dropdown", "checkboxes"],
  "ner_entity_types": ["NAME", "COLLEGE", "DEGREE", "BRANCH", "LOCATION", "SKILL"],
